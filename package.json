{
    "name": "@durachok/root",
    "version": "0.0.0",
    "description": "Durachok App",
    "license": "MIT",
    "author": "Alexander Fedotov",
    "maintainers": [
        "Alexander Fedotov"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/feds01/durachok.git"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "type": "module",
    "scripts": {
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "prepare": "turbo build --filter='./packages/*'",
        "arch": "zenith check",
        "check": "turbo check",
        "test": "turbo test",
        "build": "turbo build",
        "dev": "turbo dev"
    },
    "dependencies": {
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/node": "^26.6.6",
        "turbo": "^2.11.10",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@feds01/zenith": "^0.7.0",
        "oxfmt": "^0.28.0",
        "oxlint": "^1.92.0"
    },
    "overrides": {
        "tinypool": "^2.1.2"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "bun@1.4.4"
}
