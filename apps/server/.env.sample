# Database
MONGODB_URI=

# Authentication
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Google reCAPTCHA's secret key, with which registering is checked. Left empty, nobody is
# asked to solve one, which production refuses: it lets nobody register without it.
RE_CAPTCHA_KEY=

# AWS for static resources like user avatars
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# OpenTelemetry: traces of each API request and socket event, sent over OTLP/HTTP to this
# endpoint (an OpenTelemetry Collector, or Grafana, Honeycomb and the like). Left empty, the
# server traces nothing. OTEL_EXPORTER_OTLP_HEADERS carries a key, if the endpoint needs one.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=durachok-server
