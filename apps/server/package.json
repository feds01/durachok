{
    "name": "@durachok/server",
    "version": "1.0.0",
    "private": true,
    "author": "Alexander. E. Fedotov",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "check": "tsgo --noEmit",
        "build": "bun build src/index.ts --target=bun --packages=external --format=esm --outdir=dist --sourcemap=linked",
        "build:client": "bun src/interface/socket/generate-client.ts"
    },
    "dependencies": {
        "@3xpo/locked": "^0.1.15",
        "@aws-sdk/client-cloudfront": "^3.1159.0",
        "@aws-sdk/client-s3": "^3.1156.0",
        "@aws-sdk/s3-request-presigner": "^3.1156.0",
        "@durachok/engine": "workspace:*",
        "@durachok/transport": "workspace:*",
        "@metamorph/trpc-panel": "^1.0.5",
        "@trpc/server": "11.19.0",
        "argon2": "^0.45.1",
        "chalk": "^5.6.2",
        "cors": "2.8.6",
        "dotenv": "18.0.9",
        "express": "5.2.1",
        "fs-extra": "^11.3.3",
        "helmet": "^8.1.0",
        "jsonwebtoken": "9.0.3",
        "mongodb": "^7.7.0",
        "mongoose": "9.9.3",
        "nanoid": "5.1.16",
        "node-fetch": "^3.3.2",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "socket.io": "4.8.4",
        "superjson": "^2.2.6",
        "zod": "^4.6.7",
        "zod-sockets": "^7.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.1",
        "@types/node-fetch": "^2.6.13",
        "typescript": "^7.0.2",
        "wait-port": "^1.1.0"
    }
}
