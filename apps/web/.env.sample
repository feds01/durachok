# Application build information
REACT_APP_NAME=$npm_package_name
REACT_APP_VERSION=$npm_package_version
REACT_APP_DEV_VERSION=$npm_package_gitHead

# Build options
#GENERATE_SOURCEMAP=false

# API: the tRPC endpoint, as an absolute URL, e.g. http://localhost:8080/api/trpc,
# which is also what it is when left empty
REACT_APP_API_URL=

# Google ReCaptcha Authentication (setting to "" will disable ReCaptcha)
REACT_APP_RE_CAPTCHA_SECRET=""
