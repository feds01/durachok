# Application build information
REACT_APP_NAME=$npm_package_name
REACT_APP_VERSION=$npm_package_version
REACT_APP_DEV_VERSION=$npm_package_gitHead

# Build options
#GENERATE_SOURCEMAP=false

# API: the tRPC endpoint. Left empty, it is /api/trpc on the web app's own origin, which
# the dev server and the preview pass on to the server at API_TARGET (http://localhost:8080
# unless set). An absolute URL, e.g. http://localhost:8080/api/trpc, calls the server directly.
REACT_APP_API_URL=

# Google reCAPTCHA's site key, the public one of the pair, for the widget on the register
# form. Left empty, the form doesn't show it; the server's RE_CAPTCHA_KEY is the secret one.
REACT_APP_RE_CAPTCHA_SITE_KEY=""
