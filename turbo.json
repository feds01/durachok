{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "check": {
            "dependsOn": ["^check"]
        },
        "test": {
            "dependsOn": ["^test"],
            "passThroughEnv": ["TEST_MONGODB_URI", "TEST_SERVER_LOG"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
